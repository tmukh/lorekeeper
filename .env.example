# Copy to .env and adjust. Desktop (GPU) = indexer; laptop = query-only.
VAULT_PATH=D:\dev\obsidian-vault
OLLAMA_HOST=http://localhost:11434
LORE_LLM_MODEL=llama3.1:8b
LORE_EMBED_MODEL=nomic-embed-text
LORE_EMBED_DIM=768
# 8 GB VRAM (RTX 3060 Ti): keep this modest; Ollama offloads to CPU if it spills.
LORE_NUM_CTX=6144
# true on the desktop (may write the graph); false on the laptop (query only)
LORE_INDEXER=true
